# Telegram
TELEGRAM_BOT_TOKEN=
# Opcional (modo casal multi-bot): tokens extras, um por parceiro (CSV).
# Com um token só, os dois parceiros usam o mesmo bot.
BOT_TOKENS=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Banco de dados (driver síncrono psycopg2).
# Com Docker (docker-compose.yml): o compose sobrepõe esta variável apontando para o
# serviço "db" — basta preencher POSTGRES_PASSWORD abaixo.
# Sem Docker: postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require
DATABASE_URL=

# Senha do usuário "taskbot" no Postgres em contêiner (usada pelo docker-compose.yml).
POSTGRES_PASSWORD=

# Segurança / acesso
AUTHORIZED_CHAT_ID=
# Opcional: outros chats autorizados além do AUTHORIZED_CHAT_ID (CSV), ex.: 123,456
ALLOWED_CHAT_IDS=

# Localização
DEFAULT_TIMEZONE=America/Fortaleza

# Google Calendar (C6) — opcional. Sincronização só liga com os três definidos
# E as libs do Google instaladas. Ver docs/10_ATIVACAO_GOOGLE_CALENDAR.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
